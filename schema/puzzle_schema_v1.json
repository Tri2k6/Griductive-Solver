{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GriductivePuzzleSchema",
  "version": "1.0",
  "type": "object",
  "required": ["schema_version", "grid_size", "characters", "initial_face_up"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\s*1\\.0\\s*$"},
    "grid_size": {"type": "integer", "minimum": 2},
    "characters": {"type": "array", "items": {"$ref": "#/definitions/character"}},
    "initial_face_up": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/reference"}}
  },
  "definitions": {
    "reference": {"type": "string", "pattern": ".*\\S.*"},
    "status": {"type": "string", "pattern": "^\\s*([Cc][Rr][Ii][Mm][Ii][Nn][Aa][Ll]|[Ii][Nn][Nn][Oo][Cc][Ee][Nn][Tt])\\s*$"},
    "parity": {"type": "string", "pattern": "^\\s*([Ee][Vv][Ee][Nn]|[Oo][Dd][Dd])\\s*$"},
    "region": {
      "oneOf": [
        {"type": "object", "required": ["type", "row"], "properties": {"type": {"type": "string", "pattern": "^\\s*[Rr][Oo][Ww]\\s*$"}, "row": {"type": "integer", "minimum": 1}}},
        {"type": "object", "required": ["type", "col"], "properties": {"type": {"type": "string", "pattern": "^\\s*[Cc][Oo][Ll]\\s*$"}, "col": {"type": "string", "pattern": "^\\s*[A-Za-z]\\s*$"}}},
        {"type": "object", "required": ["type", "center"], "properties": {"type": {"type": "string", "pattern": "^\\s*[Nn][Ee][Ii][Gg][Hh][Bb][Oo][Rr][Ss]\\s*$"}, "center": {"$ref": "#/definitions/reference"}}},
        {"type": "object", "required": ["type", "cells"], "properties": {"type": {"type": "string", "pattern": "^\\s*[Ee][Xx][Pp][Ll][Ii][Cc][Ii][Tt]\\s*$"}, "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/reference"}}}},
        {"type": "object", "required": ["type", "cell_a", "cell_b"], "properties": {"type": {"type": "string", "pattern": "^\\s*[Cc][Oo][Mm][Mm][Oo][Nn]_[Nn][Ee][Ii][Gg][Hh][Bb][Oo][Rr][Ss]\\s*$"}, "cell_a": {"$ref": "#/definitions/reference"}, "cell_b": {"$ref": "#/definitions/reference"}}}
      ]
    },
    "clue_id": {"type": "string", "pattern": ".*\\S.*"},
    "fact_clue": {
      "type": "object", "required": ["type", "target", "status"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Ff][Aa][Cc][Tt]\\s*$"}, "target": {"$ref": "#/definitions/reference"}, "status": {"$ref": "#/definitions/status"}}
    },
    "same_clue": {
      "type": "object", "required": ["type", "person_a", "person_b"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Ss][Aa][Mm][Ee]\\s*$"}, "person_a": {"$ref": "#/definitions/reference"}, "person_b": {"$ref": "#/definitions/reference"}}
    },
    "different_clue": {
      "type": "object", "required": ["type", "person_a", "person_b"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Dd][Ii][Ff][Ff][Ee][Rr][Ee][Nn][Tt]\\s*$"}, "person_a": {"$ref": "#/definitions/reference"}, "person_b": {"$ref": "#/definitions/reference"}}
    },
    "exactly_clue": {
      "type": "object", "required": ["type", "k", "region"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Ee][Xx][Aa][Cc][Tt][Ll][Yy]\\s*$"}, "k": {"type": "integer", "minimum": 0}, "region": {"$ref": "#/definitions/region"}}
    },
    "at_least_clue": {
      "type": "object", "required": ["type", "k", "region"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Aa][Tt]_[Ll][Ee][Aa][Ss][Tt]\\s*$"}, "k": {"type": "integer", "minimum": 0}, "region": {"$ref": "#/definitions/region"}}
    },
    "at_most_clue": {
      "type": "object", "required": ["type", "k", "region"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Aa][Tt]_[Mm][Oo][Ss][Tt]\\s*$"}, "k": {"type": "integer", "minimum": 0}, "region": {"$ref": "#/definitions/region"}}
    },
    "parity_clue": {
      "type": "object", "required": ["type", "parity", "region"],
      "properties": {"id": {"$ref": "#/definitions/clue_id"}, "clue_id": {"$ref": "#/definitions/clue_id"}, "type": {"type": "string", "pattern": "^\\s*[Pp][Aa][Rr][Ii][Tt][Yy]\\s*$"}, "parity": {"$ref": "#/definitions/parity"}, "region": {"$ref": "#/definitions/region"}}
    },
    "clue": {
      "oneOf": [
        {"$ref": "#/definitions/fact_clue"}, {"$ref": "#/definitions/same_clue"},
        {"$ref": "#/definitions/different_clue"}, {"$ref": "#/definitions/exactly_clue"},
        {"$ref": "#/definitions/at_least_clue"}, {"$ref": "#/definitions/at_most_clue"},
        {"$ref": "#/definitions/parity_clue"}
      ]
    },
    "character": {
      "type": "object", "required": ["cell", "name", "profession", "status", "clue"],
      "properties": {
        "cell": {"type": "string", "pattern": "^\\s*[A-Za-z][1-9][0-9]*\\s*$"},
        "name": {"type": "string", "pattern": ".*\\S.*"}, "profession": {"type": "string"},
        "status": {"$ref": "#/definitions/status"}, "clue": {"$ref": "#/definitions/clue"}
      }
    }
  }
}
